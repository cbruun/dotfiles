{
  // Theming
  "icon_theme": "Catppuccin Macchiato",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "VSCode Dark Modern",
  },

  // Fonts
  "ui_font_size": 16,
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_line_height": { "custom": 1.333 },
  "buffer_font_size": 18.0,

  // Privacy
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },

  // AI
  "agent": {
    "dock": "right",
    "sidebar_side": "right",
    "enabled": true,
    "button": true,
    "model_parameters": [],
  },

  "edit_predictions": {
    "provider": "copilot",
    "mode": "subtle",
  },

  "show_edit_predictions": true,

  // Keybinds
  "base_keymap": "VSCode",

  // UI
  "fast_scroll_sensitivity": 3.0,
  "scroll_sensitivity": 2.0,
  "minimap": {
    "show": "auto",
  },
  "show_wrap_guides": true,
  "wrap_guides": [120],

  // UI - panels
  "git_panel": {
    "dock": "left",
    "tree_view": true,
  },

  "project_panel": {
    "dock": "left",
  },

  "outline_panel": {
    "dock": "left",
  },

  "collaboration_panel": {
    "dock": "left",
  },

  // Others
  "cli_default_open_behavior": "new_window",
  "file_types": {},

  // Language specific
  "languages": {
    "Terraform": {
      "format_on_save": "on",
    },
    "YAML": {
      "format_on_save": "on",
    },
    "Shell Script": {
      "format_on_save": "off",
    },
    "Markdown": {
      "remove_trailing_whitespace_on_save": false,
    },
    "JSON": {
      "format_on_save": "on",
    },
    "TOML": {
      "format_on_save": "on",
    },
  },
}
