{
  "$schema": "https://opencode.ai/config.json",
  "model": "zeldoc/zdev",
  "small_model": "zeldoc/zdev",
  "autoupdate": false,
  "provider": {
    "zeldoc": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Zeldoc",
      "options": {
        "baseURL": "https://api.zeldoc.ai/v1",
        "apiKey": "{env:ZELDOC_API_KEY}",
      },
      "models": {
        "zeldoc/zdev": {
          "name": "ZDev",
          "attachment": false,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 1000000,
            "output": 131072,
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
          "options": {
            "reasoning_effort": "high",
          },
          "variants": {
            "high": {
              "reasoningEffort": "high",
            },
            "max": {
              "reasoningEffort": "max",
            },
          },
        },
      },
    },
  },
  "permission": {
    "doom_loop": "ask",
    "edit": "allow",
    "external_directory": "ask",
    "read": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "bash": {
      // default to ask
      "*": "ask",

      // git read-only history inspection
      "git status": "allow",
      "git status *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git rev-parse": "allow",
      "git rev-parse *": "allow",
      "git blame": "allow",
      "git blame *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      // -> bare-only: with args these mutate (create branch/tag/remote)
      "git branch": "allow",
      "git tag": "allow",
      "git remote": "allow",
      "git stash list": "allow",
      "git stash list *": "allow",

      // metadata / low-risk inspection
      "column": "allow",
      "column *": "allow",
      "find": "allow",
      "find *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "sort": "allow",
      "sort *": "allow",
      "tree": "allow",
      "tree *": "allow",
      "uname": "allow",
      "uname *": "allow",
      "uniq": "allow",
      "uniq *": "allow",
      "wc": "allow",
      "wc *": "allow",
      "which": "allow",
      "which *": "allow",
      "whoami": "allow",

      // reads / extraction / transforms
      "awk *": "allow",
      "base64": "allow",
      "base64 *": "allow",
      "cat": "allow",
      "cat *": "allow",
      "diff *": "allow",
      "grep *": "allow",
      "head": "allow",
      "head *": "allow",
      "jq *": "allow",
      "rg *": "allow",
      "tail": "allow",
      "tail *": "allow",
      "yq *": "allow",

      // writes / mutates
      "cp *": "ask",
      "echo *": "ask",
      "mkdir *": "ask",
      "sed *": "ask",

      // network
      "curl *": "ask",

      // env / shell variable exposure
      "declare": "deny",
      "env": "deny",
      "export": "deny",
      // -> allow setting agent controlled variables
      "export *": "allow",
      "printenv": "deny",
      "printenv *": "deny",
      "set": "deny",
      "typeset": "deny",
    },
  },
}
