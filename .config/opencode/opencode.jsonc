{
  "$schema": "https://opencode.ai/config.json",
  "model": "zeldoc/glm-5.2",
  "small_model": "zeldoc/glm-5.2",
  "autoupdate": false,
  "agent": {
    "title": {
      "model": "zeldoc/glm-5.2",
      "variant": "low",
    },
    "summary": {
      "model": "zeldoc/glm-5.2",
      "variant": "low",
    },
  },
  "provider": {
    "zeldoc": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Zeldoc",
      "options": {
        "baseURL": "https://api.zeldoc.ai/v1",
        "apiKey": "{env:ZELDOC_API_KEY}",
      },
      "models": {
        "zeldoc/glm-5.2": {
          "name": "GLM-5.2",
          "attachment": false,
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 1000000,
            "output": 131072,
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
          "options": {
            "reasoning_effort": "high",
          },
          "variants": {
            "low": {
              "reasoningEffort": "low",
            },
            "medium": {
              "reasoningEffort": "medium",
            },
            "high": {
              "reasoningEffort": "high",
            },
            "max": {
              "reasoningEffort": "max",
            },
          },
        },
      },
    },
  },
  "permission": {
    "edit": "ask",
    "doom_loop": "ask",
    "external_directory": "ask",
    "webfetch": "ask",
    "bash": {
      // default to ask
      "*": "ask",

      // allow: metadata / low-risk inspection
      "column *": "allow",
      "find *": "allow",
      "ls *": "allow",
      "pwd *": "allow",
      "sort *": "allow",
      "tree *": "allow",
      "uname *": "allow",
      "uniq *": "allow",
      "wc *": "allow",
      "whoami *": "allow",

      // ask: reads / writes / extraction / transforms
      "awk *": "ask",
      "base64 *": "ask",
      "cat *": "ask",
      "cp *": "ask",
      "diff *": "ask",
      "echo *": "ask",
      "grep *": "ask",
      "head *": "ask",
      "jq *": "ask",
      "mkdir *": "ask",
      "rg *": "ask",
      "sed *": "ask",
      "tail *": "ask",
      "yq *": "ask",

      // ask: network
      "curl *": "ask",
    },
  },
}
